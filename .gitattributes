# 仓库在 Windows 上启用了 core.autocrlf=true。以下文件必须以 LF 入库，
# 否则在 WSL / Linux / 容器内执行时会因 CRLF 报 `$'\r': command not found`。
*.sh        text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
# systemd unit：CRLF 会让 systemd 解析失败（ExecStart 尾部带 \r）。
*.service   text eol=lf
# VERSION 由 CI 脚本读取（`tr -d '[:space:]' < VERSION`），CRLF 会在比较版本串时带出 \r。
VERSION     text eol=lf
