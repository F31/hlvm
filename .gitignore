# WorkBuddy 个人记忆与项目数据（含 MEMORY.md，禁止入库）
.workbuddy/

# 构建产物
bin/
/dist/
target/
*.exe
*.test
*.out
coverage.txt

# 本地 Go 构建缓存（本环境隔离使用，非仓库内容）
/.gocache/
/.gotmp/

# Go
/vendor/

# Rust
/target/
**/target/
Cargo.lock.bak
# agent 镜像构建上下文里的二进制（CI 由 artifact 提供，本地由容器工具链产出）
/agent/hlvm-agent

# IDE / OS
.idea/
.vscode/
.DS_Store

# 临时与敏感
*.local
secrets/
*.key

# 集成验收日志与退出码（scripts/m15-*.sh 产出，会随运行变化，不入库）
m15-*.log
m15-*.exit

# 联合测试编排产物（scripts/m15-joint.sh：基线快照 / 分相位日志 / 收尾标记）
joint-logs/

# 本地临时工作区（弱网镜像旁路的 OCI blobs / 一次性脚本，动辄上百 MB，不入库）
/tmp/
