{
  "title": "HLVM 存储平台总览",
  "uid": "hlvm-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(storage_agent_last_scan_timestamp_seconds, node)",
        "refresh": 2
      },
      {
        "name": "tier",
        "type": "textbox",
        "label": "tier（可选）"
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "ThinPool data 使用率 (%)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "storage_thinpool_data_percent{node=~\"$node\"}", "legendFormat": "{{node}}/{{vg}}" }
      ]
    },
    {
      "id": 2,
      "title": "ThinPool metadata 使用率 (%)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 75 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "storage_thinpool_metadata_percent{node=~\"$node\"}", "legendFormat": "{{node}}/{{vg}}" }
      ]
    },
    {
      "id": 3,
      "title": "磁盘健康矩阵",
      "type": "table",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "storage_disk_smart_health{node=~\"$node\"}",
          "legendFormat": "{{node}}/{{device}}"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": 0 },
                    { "color": "yellow", "value": 1 },
                    { "color": "orange", "value": 2 },
                    { "color": "red", "value": 3 }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "title": "磁盘温度 (℃) 与寿命消耗 (%)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "targets": [
        { "expr": "storage_disk_smart_temperature_celsius{node=~\"$node\"}", "legendFormat": "温度 {{node}}/{{device}}" },
        { "expr": "storage_disk_percent_used{node=~\"$node\"}", "legendFormat": "寿命 {{node}}/{{device}}" }
      ]
    },
    {
      "id": 5,
      "title": "Agent 任务失败率 (5m)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "targets": [
        { "expr": "sum by (node, task_type) (rate(storage_agent_task_failures_total[5m]))", "legendFormat": "{{node}}/{{task_type}}" }
      ]
    },
    {
      "id": 6,
      "title": "漂移计数 / 心跳丢失时长",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "targets": [
        { "expr": "count by (node) (storage_drift_detected > 0)", "legendFormat": "drift {{node}}" },
        { "expr": "(time() - storage_agent_last_scan_timestamp_seconds)", "legendFormat": "心跳丢失秒 {{node}}" }
      ]
    },
    {
      "id": 7,
      "title": "控制面 reconcile 错误",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "targets": [
        { "expr": "sum by (controller) (rate(storage_controller_reconcile_errors_total[5m]))", "legendFormat": "{{controller}}" }
      ]
    },
    {
      "id": 8,
      "title": "thin-pool 采集状态（0 = 采不到，上面两条使用率曲线此时是空而非 0）",
      "type": "stat",
      "description": "storage_thinpool_collect_ok（ADR-006 §23.13）。容量序列被 fail-closed 删掉时，使用率面板表现为 no data，和「池很空」不可区分；本面板是唯一分得开的信号。无序列 = 该 VG 不涉及 thin-pool。",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "targets": [
        { "expr": "storage_thinpool_collect_ok{node=~\"$node\"}", "legendFormat": "{{node}}/{{vg}}" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无 thin-pool",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "VG 容量（total / free，字节）",
      "type": "timeseries",
      "description": "storage_vg_total_bytes / storage_vg_free_bytes（ADR-006 §23.12）。free 只说明 thin-pool 还能从 VG 扩多少，不是「还能建多少 PVC」。曲线消失 = 采不到。",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 33 },
      "targets": [
        { "expr": "storage_vg_total_bytes{node=~\"$node\"}", "legendFormat": "{{node}}/{{vg}} total" },
        { "expr": "storage_vg_free_bytes{node=~\"$node\"}", "legendFormat": "{{node}}/{{vg}} free" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    }
  ]
}
