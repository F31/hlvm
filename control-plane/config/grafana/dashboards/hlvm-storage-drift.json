{
  "uid": "hlvm-storage-drift",
  "title": "hlvm 存储 · 三方对账与容量",
  "description": "对账可观测性面板（ADR-006 §20）：LV 上报新鲜度、被放弃的对账轮次、漂移条数、thin-pool 与 VG 容量，以及**两条容量读路径各自的采集状态**（§23.13 / §23.14：容量序列被删时曲线只剩 no data，与「很空」不可区分，必须由 collect_ok 与 unless 哨兵分开）。所有查询引用的指标均为 internal/metrics 规范名常量。",
  "tags": ["hlvm", "storage", "drift"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "数据源",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "LV 上报年龄（秒，>180 控制面整轮放弃对账）",
      "description": "time() - storage_controller_lv_report_timestamp_seconds。用时间戳而非「滞后秒数」：agent 停写后 status 不再更新，滞后秒数会冻结在挂掉前的瞬间。",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - storage_controller_lv_report_timestamp_seconds",
          "legendFormat": "{{node}}/{{vg}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "无数据（从未上报）",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 180 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "上报存在性（0 = NodeVG 存在但从未写回）",
      "description": "storage_controller_lv_report_present。present=0 时没有时间戳序列，左侧「上报年龄」对它恒为 no data —— 两个面板必须成对看。",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "storage_controller_lv_report_present",
          "legendFormat": "{{node}}/{{vg}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无数据",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "漂移条数（按 kind，平台不自动修复）",
      "description": "storage_controller_drift_items。unmanaged-lv = 绕过平台的手工 lvcreate；missing-lv = 手工 lvremove。需人工按事件建议补录或回滚。",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (storage_controller_drift_items)",
          "legendFormat": "{{kind}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "对账被放弃的轮次（按 reason）",
      "description": "increase(storage_controller_drift_reconcile_skipped_total[$__rate_interval])。reason 是闭集：no_reporter / report_missing / report_stale / no_nodevg / list_failed。**no_reporter 一旦出现表示 lvs 一侧从未接入，属配置缺失，不是瞬时故障。**",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(storage_controller_drift_reconcile_skipped_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 30, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "控制面 reconcile 错误速率（按 controller）",
      "description": "rate(storage_controller_reconcile_errors_total[5m])。持续非零意味着容量/调度决策可能基于陈旧状态。",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (controller) (rate(storage_controller_reconcile_errors_total[5m]))",
          "legendFormat": "{{controller}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "thin-pool data 使用率（阈值 75% warning / 85% critical）",
      "description": "storage_thinpool_data_percent。对应 ThinPoolDataWarning / ThinPoolDataCritical：critical 时立即置 locked，扩容由 dmeventd/capacity-ctrl 执行。",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "storage_thinpool_data_percent",
          "legendFormat": "{{node}}/{{vg}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "thin-pool metadata 使用率（阈值 50% warning / 75% critical）",
      "description": "storage_thinpool_metadata_percent。metadata 打满比 data 打满更难恢复（需进入元数据扩容预案），因此阈值更低。",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "storage_thinpool_metadata_percent",
          "legendFormat": "{{node}}/{{vg}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 75 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "agent 心跳年龄（秒，>180 告警；数据面不受影响）",
      "description": "time() - storage_agent_last_scan_timestamp_seconds。对应 AgentHeartbeatLost：只提醒，不代表存储数据面不可用。",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - storage_agent_last_scan_timestamp_seconds",
          "legendFormat": "{{node}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "thin-pool 采集状态（0 = 采不到，容量阈值告警同时静默）",
      "description": "storage_thinpool_collect_ok（ADR-006 §23.13）。序列被删时上面两个使用率面板只剩 no data，与「池很空」不可区分——本面板是唯一能把两者分开的信号。1 = 采到；0 = 配了池但采不到（5min 后触发 ThinPoolCollectFailing）；无序列 = 该 VG 不涉及 thin-pool（不该告警）。",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "expr": "storage_thinpool_collect_ok",
          "legendFormat": "{{node}}/{{vg}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无 thin-pool",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "VG 容量采集缺失（present=1 却无 vg_total；>10min 触发 VGCapacityCollectFailing）",
      "description": "storage_controller_lv_report_present{node!=\"\"} unless on(node, vg) storage_vg_total_bytes（ADR-006 §23.14）。LV 清单报上来了、同一 node+vg 的容量序列却没有 ⇒ 只有 vgs 这一条读路径坏了。空 = 正常；node=\"\" 的脏序列已被过滤，否则会永久点亮。",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 16, "x": 8, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "expr": "storage_controller_lv_report_present{node!=\"\"} unless on(node, vg) storage_vg_total_bytes",
          "legendFormat": "{{node}}/{{vg}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无缺失",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "VG 容量（total / free，字节）",
      "description": "storage_vg_total_bytes / storage_vg_free_bytes（ADR-006 §23.12）。free 只说明「thin-pool 还能从 VG 扩多少」，不是「还能建多少 PVC」——TopoLVM 按 thin-pool 容量供卷，拿 free 当可用容量会算错。曲线消失 = 采不到，看上方哨兵面板，不要读成 0。",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "targets": [
        {
          "refId": "A",
          "expr": "storage_vg_total_bytes",
          "legendFormat": "{{node}}/{{vg}} total",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "storage_vg_free_bytes",
          "legendFormat": "{{node}}/{{vg}} free",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    }
  ]
}
